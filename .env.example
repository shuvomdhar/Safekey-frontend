# Where the Express API lives. The Next.js dev/prod server proxies /api/* here.
BACKEND_URL=http://localhost:4000

# Optional: only needed if you want the browser to call the API directly
# (bypassing the proxy). Leave empty for the recommended setup.
NEXT_PUBLIC_API_URL=

# Supabase → Project Settings → API. These are public values and are inlined
# into the browser bundle at build time, so rebuild after changing them.
# Google OAuth is handled entirely by Supabase Auth; the backend verifies the
# resulting access token with the same project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
